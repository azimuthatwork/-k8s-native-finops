apiVersion: audit.k8s.io/v1
kind: Policy
# Audit Policy for FinOps Platform
# Logs metadata for pod/pvc lifecycle events for cost tracking
rules:
  # Pod lifecycle - track creation/deletion for cost attribution
  - level: Metadata
    resources:
    - group: ""
      resources: ["pods"]
    verbs: ["create", "delete", "update", "patch"]
    namespaces: ["*"]
  
  # PVC lifecycle - track storage provisioning costs
  - level: Metadata
    resources:
    - group: ""
      resources: ["persistentvolumeclaims"]
    verbs: ["create", "delete", "update", "patch"]
    namespaces: ["*"]
  
  # PV lifecycle - track storage costs
  - level: Metadata
    resources:
    - group: ""
      resources: ["persistentvolumes"]
    verbs: ["create", "delete", "update", "patch"]
  
  # Node lifecycle - track node costs
  - level: Metadata
    resources:
    - group: ""
      resources: ["nodes"]
    verbs: ["create", "delete", "update", "patch"]
  
  # Namespace lifecycle - track namespace costs
  - level: Metadata
    resources:
    - group: ""
      resources: ["namespaces"]
    verbs: ["create", "delete", "update", "patch"]
  
  # Deployment/StatefulSet/DaemonSet - track workload changes
  - level: Metadata
    resources:
    - group: "apps"
      resources: ["deployments", "statefulsets", "daemonsets", "replicasets"]
    verbs: ["create", "delete", "update", "patch"]
    namespaces: ["*"]
  
  # Jobs/CronJobs - track batch workload costs
  - level: Metadata
    resources:
    - group: "batch"
      resources: ["jobs", "cronjobs"]
    verbs: ["create", "delete", "update", "patch"]
    namespaces: ["*"]
  
  # Services/Ingress - track network costs (LB creation)
  - level: Metadata
    resources:
    - group: ""
      resources: ["services"]
    verbs: ["create", "delete", "update", "patch"]
    namespaces: ["*"]
  
  - level: Metadata
    resources:
    - group: "networking.k8s.io"
      resources: ["ingresses"]
    verbs: ["create", "delete", "update", "patch"]
    namespaces: ["*"]
  
  # ConfigMaps/Secrets - track configuration changes (RequestResponse for debugging)
  - level: RequestResponse
    resources:
    - group: ""
      resources: ["configmaps", "secrets"]
    verbs: ["create", "update", "patch"]
    namespaces: ["*"]
  
  # Default rule - log metadata for all other requests
  - level: Metadata
    namespaces: ["*"]
