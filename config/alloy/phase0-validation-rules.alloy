// Phase 0 Validation Rules for Alloy Configuration
// This file documents the expected Alloy configuration patterns for Phase 0 validation
// It serves as a reference for the validation scripts

// =============================================================================
// ALLOY DAEMONSET CONFIG (config.alloy - Node Level)
// =============================================================================

// 1. Node Exporter Integration (REQUIRED)
prometheus.exporter.node "default" {
  // Should be enabled with default settings
  // Scrapes: node_cpu_seconds_total, node_memory_*, node_filesystem_*, node_network_*
}

// 2. cAdvisor Integration (REQUIRED)
prometheus.exporter.cadvisor "default" {
  // Should be enabled with default settings
  // Critical metrics for cost optimization:
  // - container_spec_memory_limit_bytes
  // - container_spec_cpu_quota / container_spec_cpu_period
  // - container_memory_working_set_bytes
  // - container_cpu_usage_seconds_total
  // - container_fs_usage_bytes
  // - container_fs_limit_bytes
}

// 3. Pod Logs Collection with Cost Labels (REQUIRED)
loki.source.kubernetes "pod_logs" {
  // Labels MUST include:
  labels = {
    namespace = __meta_kubernetes_namespace
    pod       = __meta_kubernetes_pod_name
    container = __meta_kubernetes_container_name
    // Cost correlation labels (injected via relabeling)
    cost_center = __meta_kubernetes_namespace_label_cost_center
    team        = __meta_kubernetes_namespace_label_team
  }
  
  // Relabeling rules to inject cost labels from namespace metadata
  relabel_rules = [
    // Extract cost_center from namespace labels
    {
      source_labels = ["__meta_kubernetes_namespace_label_cost_center"]
      target_label  = "cost_center"
      action        = "replace"
    },
    // Extract team from namespace labels
    {
      source_labels = ["__meta_kubernetes_namespace_label_team"]
      target_label  = "team"
      action        = "replace"
    }
  ]
}

// 4. Prometheus Scrape for Node Exporter (for network metrics)
prometheus.scrape "node_exporter" {
  targets = discovery.kubernetes "nodes" {
    role = "pod"
    label_selector = "app=alloy-daemonset"
  }
  forward_to = [prometheus.remote_write.default.receiver]
  // Should include node_network_* metrics for network cost tracking
}

// =============================================================================
// ALLOY CENTRAL CONFIG (config.alloy - Cluster Level)
// =============================================================================

// 1. Prometheus Remote Write to HA Pair (REQUIRED)
prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus-operated-0.monitoring:9090/api/v1/write"
  }
  endpoint {
    url = "http://prometheus-operated-1.monitoring:9090/api/v1/write"
  }
  // Fan-out to Thanos Receive (Phase 2 - optional)
  // endpoint {
  //   url = "http://thanos-receive.monitoring:19291/api/v1/receive"
  // }
}

// 2. Loki Write (REQUIRED)
loki.write "default" {
  endpoint {
    url = "http://loki-distributor.monitoring:3100/loki/api/v1/push"
  }
}

// 3. Kube State Metrics Scrape (REQUIRED)
prometheus.scrape "kube_state_metrics" {
  targets = discovery.kubernetes "kube_state_metrics" {
    role = "service"
    namespaces = ["kube-system", "monitoring"]
    label_selector = "app=kube-state-metrics"
  }
  forward_to = [prometheus.remote_write.default.receiver]
  
  // Critical metrics for cost optimization:
  // - kube_pod_container_resource_requests{resource="cpu|memory"}
  // - kube_pod_container_resource_limits{resource="cpu|memory"}
  // - kube_node_status_capacity{resource="cpu|memory|pods"}
  // - kube_node_status_allocatable{resource="cpu|memory|pods"}
  // - kube_pod_owner (for workload mapping)
  // - kube_namespace_labels (for cost-center mapping)
}

// 4. OpenCost Scrape (Phase 1.3 - will be added)
/*
prometheus.scrape "opencost" {
  targets = discovery.kubernetes "opencost" {
    role = "service"
    namespaces = ["cost-management"]
    label_selector = "app=opencost"
  }
  forward_to = [prometheus.remote_write.default.receiver]
}
*/

// 5. Prometheus Scrape for Alloy DaemonSet (REQUIRED)
prometheus.scrape "alloy_daemonset" {
  targets = discovery.kubernetes "alloy_daemonset" {
    role = "pod"
    namespaces = ["monitoring"]
    label_selector = "app=alloy-daemonset"
  }
  forward_to = [prometheus.remote_write.default.receiver]
}

// =============================================================================
// VALIDATION CHECKLIST
// =============================================================================

/*
DAEMONSET VALIDATION:
☐ prometheus.exporter.node enabled
☐ prometheus.exporter.cadvisor enabled with all critical metrics
☐ loki.source.kubernetes configured with namespace, pod, container labels
☐ loki.source.kubernetes has cost_center and team labels via relabeling
☐ prometheus.scrape for node-exporter includes node_network_* metrics

CENTRAL VALIDATION:
☐ prometheus.remote_write points to Prometheus HA pair (both endpoints)
☐ loki.write configured to Loki Distributor/Gateway
☐ prometheus.scrape for kube-state-metrics with all critical metrics
☐ prometheus.scrape for opencost (Phase 1.3)
☐ prometheus.remote_write fan-out to Thanos Receive (Phase 2)
☐ loki.write to Loki Distributor/Gateway
*/
