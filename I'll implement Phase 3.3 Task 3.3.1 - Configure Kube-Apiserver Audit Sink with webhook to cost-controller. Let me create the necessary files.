// AuditHandler handles incoming audit events from kube-apiserver
type AuditHandler struct {
	logger         *zap.Logger
	eventController EventControllerInterface
}

// EventControllerInterface defines the interface for event controller
type EventControllerInterface interface {
	CreateLogEvent(ctx context.Context, event *LogEvent) error
}

// NewAuditHandler creates a new audit handler
func NewAuditHandler(logger *zap.Logger, eventController EventControllerInterface) *AuditHandler {
	return &AuditHandler{
		logger:          logger.Named("audit-handler"),
		eventController: eventController,
	}
}

// ServeHTTP handles POST requests from kube-apiserver audit webhook
func (h *AuditHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {
	start := time.Now()
	
	// Only accept POST requests
	if r.Method != http.MethodPost {
		h.logger.Warn("Invalid HTTP method for audit webhook", zap.String("method", r.Method))
		http.Error(w, "Method not allowed", http.StatusMethodNotAllowed)
		return
	}
	
	// Read request body
	body, err := io.ReadAll(r.Body)
	if err != nil {
		h.logger.Error("Failed to read audit request body", zap.Error(err))
		http.Error(w, "Failed to read request body", http.StatusBadRequest)
		return
	}
	defer r.Body.Close()
	
	// Parse audit event list
	var eventList audit.EventList
	if err := json.Unmarshal(body, &eventList); err != nil {
		h.logger.Error("Failed to unmarshal audit event list", zap.Error(err), zap.String("body", string(body)))
		http.Error(w, "Invalid audit event format", http.StatusBadRequest)
		return
	}
	
	h.logger.Debug("Received audit events", zap.Int("count", len(eventList.Items)))
	
	// Process each event
	processed := 0
	failed := 0
	for _, event := range eventList.Items {
		if err := h.processEvent(r.Context(), &event); err != nil {
			h.logger.Error("Failed to process audit event", 
				zap.Error(err),
				zap.String("verb", event.Verb),
				zap.String("resource", event.ObjectRef.Resource),
				zap.String("namespace", event.ObjectRef.Namespace),
				zap.String("name", event.ObjectRef.Name),
			)
			failed++
			
			auditEventsFailed.WithLabelValues(
				event.Verb,
				event.ObjectRef.Resource,
				event.ObjectRef.Namespace,
				"processing_error",
			).Inc()
		} else {
			processed++
			auditEventsProcessed.WithLabelValues(
				event.Verb,
				event.ObjectRef.Resource,
				event.ObjectRef.Namespace,
			).Inc()
		}
		
		// Record metrics for all received events
		auditEventsReceived.WithLabelValues(
			event.Verb,
			event.ObjectRef.Resource,
			event.ObjectRef.Namespace,
			event.User.Username,
			string(event.ResponseStatus.Code),
		).Inc()
		
		auditProcessingDuration.WithLabelValues(
			event.Verb,
			event.ObjectRef.Resource,
		).Observe(time.Since(start).Seconds())
	}
	
	h.logger.Debug("Processed audit events", 
		zap.Int("processed", processed), 
		zap.Int("failed", failed),
		zap.Duration("duration", time.Since(start)),
	)
	
	// Respond with 200 OK
	w.WriteHeader(http.StatusOK)
	w.Write([]byte(`{"status": "ok"}`))
}

// processEvent processes a single audit event
func (h *AuditHandler) processEvent(ctx context.Context, event *audit.Event) error {
	// Skip if not a relevant resource
	if !h.isRelevantResource(event) {
		return nil
	}
	
	// Extract key information
	verb := event.Verb
	resource := event.ObjectRef.Resource
	namespace := event.ObjectRef.Namespace
	name := event.ObjectRef.Name
	uid := event.ObjectRef.UID
	user := event.User.Username
	
	// Get namespace labels for cost-center/team enrichment
	costCenter := h.getCostCenter(ctx, namespace)
	team := h.getTeam(ctx, namespace)
	
	// Create LogEvent CRD for significant events
	if h.shouldCreateLogEvent(event) {
		logEvent := h.buildLogEvent(event, costCenter, team)
		if err := h.eventController.CreateLogEvent(ctx, logEvent); err != nil {
			return fmt.Errorf("failed to create LogEvent CRD: %w", err)
		}
	}
	
	// Emit Prometheus metrics for audit events
	h.emitAuditMetrics(event, costCenter, team)
	
	return nil
}

// isRelevantResource checks if the event is for a resource we care about
func (h *AuditHandler) isRelevantResource(event *audit.Event) bool {
	relevantResources := map[string]bool{
		"pods":                      true,
		"persistentvolumeclaims":    true,
		"persistentvolumes":         true,
		"nodes":                     true,
		"namespaces":                true,
		"deployments":               true,
		"statefulsets":              true,
		"daemonsets":                true,
		"replicasets":               true,
		"jobs":                      true,
		"cronjobs":                  true,
		"services":                  true,
		"ingresses":                 true,
		"configmaps":                true,
		"secrets":                   true,
	}
	
	return relevantResources[event.ObjectRef.Resource]
}

// shouldCreateLogEvent determines if we should create a LogEvent CRD
func (h *AuditHandler) shouldCreateLogEvent(event *audit.Event) bool {
	// Create LogEvent for write operations on cost-relevant resources
	writeVerbs := map[string]bool{
		"create": true,
		"delete": true,
		"update": true,
		"patch":  true,
	}
	
	costRelevantResources := map[string]bool{
		"pods":                   true,
		"persistentvolumeclaims": true,
		"persistentvolumes":      true,
		"nodes":                  true,
		"services":               true, // LoadBalancer creation = cost
		"ingresses":              true, // Ingress controller = cost
	}
	
	return writeVerbs[event.Verb] && costRelevantResources[event.ObjectRef.Resource]
}

// buildLogEvent creates a LogEvent from an audit event
func (h *AuditHandler) buildLogEvent(event *audit.Event, costCenter, team string) *LogEvent {
	now := metav1.Now()
	
	// Determine reason based on resource and verb
	reason := fmt.Sprintf("%s%s", strings.Title(event.Verb), strings.Title(event.ObjectRef.Resource))
	
	// Map to standard reasons
	reasonMap := map[string]string{
		"CreatePods":                   "PodCreated",
		"DeletePods":                   "PodDeleted",
		"UpdatePods":                   "PodUpdated",
		"PatchPods":                    "PodPatched",
		"CreatePersistentvolumeclaims": "PVCProvisioned",
		"DeletePersistentvolumeclaims": "PVCDeleted",
		"CreatePersistentvolumes":      "PVProvisioned",
		"DeletePersistentvolumes":      "PVDeleted",
		"CreateNodes":                  "NodeRegistered",
		"DeleteNodes":                  "NodeRemoved",
		"CreateServices":               "ServiceCreated",
		"DeleteServices":               "ServiceDeleted",
		"CreateIngresses":              "IngressCreated",
		"DeleteIngresses":              "IngressDeleted",
	}
	
	if mappedReason, ok := reasonMap[reason]; ok {
		reason = mappedReason
	}
	
	// Build workload reference if applicable
	var workloadRef *WorkloadReference
	if event.ObjectRef.Resource == "pods" {
		// Try to get owner reference from the event
		workloadRef = h.extractWorkloadRef(event)
	}
	
	return &LogEvent{
		ObjectMeta: metav1.ObjectMeta{
			GenerateName: fmt.Sprintf("audit-%s-%s-", strings.ToLower(event.ObjectRef.Resource), strings.ToLower(event.Verb)),
			Labels: map[string]string{
				"finops.io/source":        "audit",
				"finops.io/verb":          event.Verb,
				"finops.io/resource":      event.ObjectRef.Resource,
				"finops.io/cost-center":   costCenter,
				"finops.io/team":          team,
			},
		},
		Spec: LogEventSpec{
			Namespace:   event.ObjectRef.Namespace,
			WorkloadRef: workloadRef,
			Reason:      reason,
			Message:     h.buildEventMessage(event),
			Source:      "kube-apiserver-audit",
			Severity:    h.determineSeverity(event),
			Metadata: map[string]string{
				"user":           event.User.Username,
				"userGroups":     strings.Join(event.User.Groups, ","),
				"sourceIP":       event.SourceIPs[0],
				"userAgent":      event.UserAgent,
				"objectName":     event.ObjectRef.Name,
				"objectUID":      string(event.ObjectRef.UID),
				"responseCode":   fmt.Sprintf("%d", event.ResponseStatus.Code),
				"responseStatus": event.ResponseStatus.Status,
			},
		},
		Status: LogEventStatus{
			Processed:   true,
			ProcessedAt: &now,
		},
	}
}

// extractWorkloadRef extracts workload reference from pod event
func (h *AuditHandler) extractWorkloadRef(event *audit.Event) *WorkloadReference {
	// For pod events, we'd need to fetch the pod to get owner references
	// This is a simplified version - in production, you'd query the API server
	// or use the ObjectRef if it contains owner info
	return nil
}

// buildEventMessage creates a human-readable message
func (h *AuditHandler) buildEventMessage(event *audit.Event) string {
	return fmt.Sprintf("%s %s/%s by %s from %s",
		event.Verb,
		event.ObjectRef.Namespace,
		event.ObjectRef.Name,
		event.User.Username,
		strings.Join(event.SourceIPs, ","),
	)
}

// determineSeverity determines the severity of the event
func (h *AuditHandler) determineSeverity(event *audit.Event) string {
	// Deletions are higher severity
	if event.Verb == "delete" {
		return "Warning"
	}
	
	// Failed requests are higher severity
	if event.ResponseStatus.Code >= 400 {
		return "Error"
	}
	
	// Service/Ingress creation (potential cost) is Info
	if (event.ObjectRef.Resource == "services" || event.ObjectRef.Resource == "ingresses") && 
		(event.Verb == "create" || event.Verb == "update") {
		return "Info"
	}
	
	return "Info"
}

// getCostCenter retrieves cost-center label for namespace
func (h *AuditHandler) getCostCenter(ctx context.Context, namespace string) string {
	if namespace == "" {
		return "cluster"
	}
	// In production, this would query a namespace cache
	// For now, return a placeholder
	return "unknown"
}

// getTeam retrieves team label for namespace
func (h *AuditHandler) getTeam(ctx context.Context, namespace string) string {
	if namespace == "" {
		return "platform"
	}
	return "unknown"
}

// emitAuditMetrics emits Prometheus metrics for audit events
func (h *AuditHandler) emitAuditMetrics(event *audit.Event, costCenter, team string) {
