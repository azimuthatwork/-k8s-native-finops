var (
	logEventsCreated = promauto.NewCounterVec(
		prometheus.CounterOpts{
			Name: "finops_log_events_created_total",
			Help: "Total number of LogEvent CRDs created",
		},
		[]string{"reason", "namespace", "source", "severity"},
	)
	
	logEventsFailed = promauto.NewCounterVec(
		prometheus.CounterOpts{
