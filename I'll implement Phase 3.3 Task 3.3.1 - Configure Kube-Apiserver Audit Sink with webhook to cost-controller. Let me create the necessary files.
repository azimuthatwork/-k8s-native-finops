var (
	auditEventsReceived = promauto.NewCounterVec(
		prometheus.CounterOpts{
			Name: "finops_audit_events_received_total",
			Help: "Total number of audit events received from kube-apiserver",
		},
		[]string{"verb", "resource", "namespace", "user", "result"},
	)
	
	auditEventsProcessed = promauto.NewCounterVec(
		prometheus.CounterOpts{
			Name: "finops_audit_events_processed_total",
			Help: "Total number of audit events successfully processed",
		},
		[]string{"verb", "resource", "namespace"},
	)
	
	auditEventsFailed = promauto.NewCounterVec(
		prometheus.CounterOpts{
			Name: "finops_audit_events_failed_total",
			Help: "Total number of audit events that failed processing",
		},
		[]string{"verb", "resource", "namespace", "error"},
	)
	
	auditProcessingDuration = promauto.NewHistogramVec(
		prometheus.HistogramOpts{
			Name:    "finops_audit_processing_duration_seconds",
			Help:    "Time spent processing audit events",
			Buckets: prometheus.DefBuckets,
		},
		[]string{"verb", "resource"},
	)
