package main

import (
	"context"
	"flag"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"github.com/prometheus/client_golang/prometheus/promhttp"
	"go.uber.org/zap"
	"k8s.io/apimachinery/pkg/runtime"
	utilruntime "k8s.io/apimachinery/pkg/util/runtime"
	clientgoscheme "k8s.io/client-go/kubernetes/scheme"
	_ "k8s.io/client-go/plugin/pkg/client/auth"
	ctrl "sigs.k8s.io/controller-runtime"
	"sigs.k8s.io/controller-runtime/pkg/healthz"
	"sigs.k8s.io/controller-runtime/pkg/log/zap"
	"sigs.k8s.io/controller-runtime/pkg/manager"
	"sigs.k8s.io/controller-runtime/pkg/metrics/server"

	finopsv1alpha1 "github.com/yourorg/kube-native-finops/api/v1alpha1"
	"github.com/yourorg/kube-native-finops/pkg/allocation"
	"github.com/yourorg/kube-native-finops/pkg/api"
	"github.com/yourorg/kube-native-finops/pkg/clients"
	"github.com/yourorg/kube-native-finops/pkg/storage"
	"github.com/yourorg/kube-native-finops/controllers"
)

var (
	scheme   = runtime.NewScheme()
	setupLog = ctrl.Log.WithName("setup")
)

func init() {
	utilruntime.Must(clientgoscheme.AddToScheme(scheme))
	utilruntime.Must(finopsv1alpha1.AddToScheme(scheme))
}

func main() {
	var metricsAddr string
	var enableLeaderElection bool
	var probeAddr string
	var tsdbPath string
	var webhookPort int
	
	flag.StringVar(&metricsAddr, "metrics-bind-address", ":8080", "The address the metric endpoint binds to.")
	flag.StringVar(&probeAddr, "health-probe-bind-address", ":8081", "The address the probe endpoint binds to.")
	flag.BoolVar(&enableLeaderElection, "leader-elect", true, "Enable leader election for controller manager.")
	flag.StringVar(&tsdbPath, "tsdb-path", "/data/tsdb", "Path to TSDB data directory.")
	flag.IntVar(&webhookPort, "webhook-port", 8081, "Port for webhook server (audit, logs).")
	flag.Parse()

	ctrl.SetLogger(zap.New(zap.UseDevMode(true)))

	mgr, err := ctrl.NewManager(ctrl.GetConfigOrDie(), ctrl.Options{
		Scheme:                 scheme,
		Metrics:                server.Options{BindAddress: metricsAddr},
		HealthProbeBindAddress: probeAddr,
		LeaderElection:         enableLeaderElection,
		LeaderElectionID:       "cost-controller-leader",
	})
	if err != nil {
		setupLog.Error(err, "unable to start manager")
		os.Exit(1)
	}

	// Initialize clients
	clientFactory := clients.NewClientFactory(mgr.GetConfig(), mgr.GetClient(), setupLog)
	if err := clientFactory.Start(context.Background()); err != nil {
		setupLog.Error(err, "failed to start client factory")
		os.Exit(1)
	}
	defer clientFactory.Stop()

	// Initialize TSDB
	tsdb, err := storage.NewTSDB(tsdbPath, setupLog)
	if err != nil {
		setupLog.Error(err, "failed to initialize TSDB")
		os.Exit(1)
	}
	defer tsdb.Close()

	// Initialize allocation engine
	allocEngine := allocation.NewEngine(clientFactory, tsdb, setupLog)

	// Initialize API server
	apiServer := api.NewServer(allocEngine, tsdb, clientFactory, mgr.GetClient(), scheme, setupLog)

	// Setup controllers
	if err := controllers.SetupControllers(mgr, allocEngine, clientFactory, tsdb, setupLog); err != nil {
		setupLog.Error(err, "unable to setup controllers")
		os.Exit(1)
	}

	// Setup webhook server for audit and log ingestion
	webhookServer := &http.Server{
		Addr:         fmt.Sprintf(":%d", webhookPort),
		ReadTimeout:  30 * time.Second,
		WriteTimeout: 30 * time.Second,
	}

	// Register audit handler
	auditHandler := api.NewAuditHandler(setupLog, apiServer.GetEventController())
	http.Handle("/api/v1/audit", auditHandler)

	// Register log ingestion handler
	logHandler := api.NewLogEventHandler(setupLog, apiServer.GetEventController())
	http.Handle("/api/v1/logs", logHandler)

	// Health endpoints
	http.HandleFunc("/healthz", func(w http.ResponseWriter, r *http.Request) {
		w.WriteHeader(http.StatusOK)
		w.Write([]byte("ok"))
	})
	http.HandleFunc("/readyz", func(w http.ResponseWriter, r *http.Request) {
		w.WriteHeader(http.StatusOK)
		w.Write([]byte("ready"))
	})

	// Metrics endpoint
	http.Handle("/metrics", promhttp.Handler())

	// Start webhook server in background
	go func() {
		setupLog.Info("Starting webhook server", "port", webhookPort)
		if err := webhookServer.ListenAndServe(); err != nil && err != http.ErrServerClosed {
			setupLog.Error(err, "webhook server failed")
			os.Exit(1)
		}
	}()

	// Start manager
	ctx := ctrl.SetupSignalHandler()
	if err := mgr.Start(ctx); err != nil {
		setupLog.Error(err, "problem running manager")
		os.Exit(1)
	}

	// Graceful shutdown
	shutdownCtx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
	defer cancel()
	if err := webhookServer.Shutdown(shutdownCtx); err != nil {
		setupLog.Error(err, "failed to shutdown webhook server")
	}
}
