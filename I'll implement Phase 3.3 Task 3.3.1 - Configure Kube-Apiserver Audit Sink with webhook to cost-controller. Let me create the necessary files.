// EventController manages LogEvent CRDs
type EventController struct {
	client.Client
	Scheme *runtime.Scheme
	Logger *zap.Logger
}

// NewEventController creates a new event controller
func NewEventController(client client.Client, scheme *runtime.Scheme, logger *zap.Logger) *EventController {
	return &EventController{
		Client: client,
		Scheme: scheme,
		Logger: logger.Named("event-controller"),
	}
}

// CreateLogEvent creates a LogEvent CRD
func (c *EventController) CreateLogEvent(ctx context.Context, event *LogEvent) error {
	// Convert to CRD type
	logEvent := &finopsv1alpha1.LogEvent{
		ObjectMeta: metav1.ObjectMeta{
			GenerateName: event.ObjectMeta.GenerateName,
			Labels:       event.ObjectMeta.Labels,
			Annotations:  event.ObjectMeta.Annotations,
		},
		Spec: finopsv1alpha1.LogEventSpec{
			Namespace: event.Spec.Namespace,
			Reason:    event.Spec.Reason,
			Message:   event.Spec.Message,
			Source:    event.Spec.Source,
			Severity:  event.Spec.Severity,
			Metadata:  event.Spec.Metadata,
		},
	}
	
	if event.Spec.WorkloadRef != nil {
		logEvent.Spec.WorkloadRef = &finopsv1alpha1.WorkloadReference{
			Name: event.Spec.WorkloadRef.Name,
			Kind: event.Spec.WorkloadRef.Kind,
			UID:  event.Spec.WorkloadRef.UID,
		}
	}
	
	// Create the LogEvent
	if err := c.Create(ctx, logEvent); err != nil {
		if errors.IsAlreadyExists(err) {
			// LogEvent already exists, try to update
			existing := &finopsv1alpha1.LogEvent{}
			if err := c.Get(ctx, types.NamespacedName{Name: logEvent.Name, Namespace: logEvent.Namespace}, existing); err != nil {
				return err
			}
			existing.Spec = logEvent.Spec
			existing.Labels = logEvent.Labels
			if err := c.Update(ctx, existing); err != nil {
				return err
			}
		} else {
			c.Logger.Error("Failed to create LogEvent", zap.Error(err))
			logEventsFailed.WithLabelValues(
				event.Spec.Reason,
				event.Spec.Namespace,
				"create_failed",
			).Inc()
			return err
		}
	}
	
	logEventsCreated.WithLabelValues(
		event.Spec.Reason,
		event.Spec.Namespace,
		event.Spec.Source,
		event.Spec.Severity,
	).Inc()
	
	c.Logger.Debug("Created LogEvent", 
		zap.String("name", logEvent.Name),
		zap.String("namespace", logEvent.Namespace),
		zap.String("reason", event.Spec.Reason),
	)
	
	return nil
}

// LogEventHandler handles log ingestion from Fluent Bit or other sources
type LogEventHandler struct {
	client.Client
	Scheme *runtime.Scheme
	Logger *zap.Logger
}

// NewLogEventHandler creates a new log event handler
func NewLogEventHandler(client client.Client, scheme *runtime.Scheme, logger *zap.Logger) *LogEventHandler {
	return &LogEventHandler{
		Client: client,
		Scheme: scheme,
		Logger: logger.Named("log-event-handler"),
	}
}

// ServeHTTP handles POST requests with log events
func (h *LogEventHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost {
		http.Error(w, "Method not allowed", http.StatusMethodNotAllowed)
		return
	}
	
	// Parse JSON body
	var logEntry map[string]interface{}
	if err := json.NewDecoder(r.Body).Decode(&logEntry); err != nil {
		h.Logger.Error("Failed to decode log entry", zap.Error(err))
		http.Error(w, "Invalid JSON", http.StatusBadRequest)
		return
	}
	
	// Extract fields
	namespace := getString(logEntry, "namespace")
	podName := getString(logEntry, "pod_name")
	containerName := getString(logEntry, "container_name")
	logMessage := getString(logEntry, "log")
	level := getString(logEntry, "level")
	
	// Determine reason from log content
	reason := h.classifyLogEvent(logMessage, level)
	if reason == "" {
		// Not an event we care about
		w.WriteHeader(http.StatusOK)
		return
	}
	
	// Get workload reference from pod
	workloadRef := h.getWorkloadRef(ctx, namespace, podName)
	
	// Get cost center/team from namespace
	costCenter := h.getCostCenter(ctx, namespace)
	team := h.getTeam(ctx, namespace)
	
	// Create LogEvent
	logEvent := &finopsv1alpha1.LogEvent{
		ObjectMeta: metav1.ObjectMeta{
			GenerateName: fmt.Sprintf("log-%s-%s-", strings.ToLower(reason), strings.ToLower(level)),
			Labels: map[string]string{
				"finops.io/source":      "container-log",
				"finops.io/reason":      strings.ToLower(reason),
				"finops.io/level":       strings.ToLower(level),
				"finops.io/cost-center": costCenter,
				"finops.io/team":        team,
			},
		},
		Spec: finopsv1alpha1.LogEventSpec{
			Namespace:   namespace,
			WorkloadRef: workloadRef,
			Reason:      reason,
			Message:     logMessage,
			Source:      "container-log",
			Severity:    level,
			Metadata: map[string]string{
				"pod":       podName,
				"container": containerName,
			},
		},
		Status: finopsv1alpha1.LogEventStatus{
			Processed:   true,
			ProcessedAt: &metav1.Time{Time: time.Now()},
		},
	}
	
	if err := h.Create(ctx, logEvent); err != nil {
		h.Logger.Error("Failed to create LogEvent from log", zap.Error(err))
		logEventsFailed.WithLabelValues(reason, namespace, "create_failed").Inc()
		http.Error(w, "Failed to create LogEvent", http.StatusInternalServerError)
		return
	}
	
	logEventsCreated.WithLabelValues(reason, namespace, "container-log", level).Inc()
	
	// Also emit Prometheus metric
	// finops_log_errors_total{namespace, workload, container, level}++
	
	w.WriteHeader(http.StatusOK)
	w.Write([]byte(`{"status": "ok"}`))
}

// classifyLogEvent classifies a log message into a reason
func (h *LogEventHandler) classifyLogEvent(message, level string) string {
	messageLower := strings.ToLower(message)
	
	// OOM detection
	if strings.Contains(messageLower, "oom") || 
	   strings.Contains(messageLower, "out of memory") ||
	   strings.Contains(messageLower, "memory limit") {
		return "OOMKilling"
	}
	
	// Error/Exception detection
	if level == "error" || level == "fatal" || level == "panic" {
		if strings.Contains(messageLower, "exception") {
			return "Exception"
		}
		return "Error"
	}
	
	// Crash detection
	if strings.Contains(messageLower, "crash") || 
	   strings.Contains(messageLower, "segmentation fault") ||
	   strings.Contains(messageLower, "sigkill") ||
	   strings.Contains(messageLower, "sigterm") {
		return "CrashLoopBackOff"
	}
	
	// Throttling detection
	if strings.Contains(messageLower, "throttl") {
		return "Throttled"
	}
	
	return ""
}

