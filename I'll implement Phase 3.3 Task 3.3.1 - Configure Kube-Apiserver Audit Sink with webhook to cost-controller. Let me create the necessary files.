#!/bin/bash
# validate-audit-webhook.sh - Validates audit webhook configuration

set -euo pipefail

NAMESPACE="cost-management"
POD_LABEL="app.kubernetes.io/name=cost-controller"
AUDIT_PORT=8081

echo "=== Validating Audit Webhook Configuration ==="

# Check 1: Cost Controller pod is running
echo "Check 1: Cost Controller pod status"
POD=$(kubectl get pods -n $NAMESPACE -l $POD_LABEL -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
if [ -z "$POD" ]; then
    echo "FAIL: No cost-controller pod found"
    exit 1
fi
echo "PASS: Found pod $POD"

# Check 2: Pod is ready
READY=$(kubectl get pod -n $NAMESPACE $POD -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}')
if [ "$READY" != "True" ]; then
    echo "FAIL: Pod $POD is not ready"
    exit 1
fi
echo "PASS: Pod $POD is ready"

# Check 3: Audit webhook endpoint responds
echo "Check 3: Audit webhook endpoint health"
if kubectl exec -n $NAMESPACE $POD -- wget -qO- --timeout=5 http://localhost:$AUDIT_PORT/healthz 2>/dev/null | grep -q "ok"; then
    echo "PASS: Health endpoint responds"
else
    echo "FAIL: Health endpoint not responding"
    exit 1
fi

# Check 4: Audit webhook endpoint accepts POST
echo "Check 4: Audit webhook endpoint accepts POST"
TEST_PAYLOAD='{"kind":"EventList","apiVersion":"audit.k8s.io/v1","items":[]}'
RESPONSE=$(kubectl exec -n $NAMESPACE $POD -- wget -qO- --timeout=5 --post-data="$TEST_PAYLOAD" --header="Content-Type: application/json" http://localhost:$AUDIT_PORT/api/v1/audit 2>/dev/null)
if echo "$RESPONSE" | grep -q "ok"; then
    echo "PASS: Audit webhook accepts POST requests"
else
    echo "FAIL: Audit webhook did not accept POST"
    echo "Response: $RESPONSE"
    exit 1
fi

# Check 5: Service exists
echo "Check 5: Audit service exists"
if kubectl get svc -n $NAMESPACE cost-controller-audit >/dev/null 2>&1; then
    echo "PASS: Service cost-controller-audit exists"
else
    echo "FAIL: Service cost-controller-audit not found"
    exit 1
fi

# Check 6: RBAC permissions
echo "Check 6: RBAC permissions"
if kubectl auth can-i create logevents --as=system:serviceaccount:$NAMESPACE:cost-controller-sa >/dev/null 2>&1; then
    echo "PASS: SA can create LogEvents"
else
    echo "FAIL: SA cannot create LogEvents"
    exit 1
fi

if kubectl auth can-i get namespaces --as=system:serviceaccount:$NAMESPACE:cost-controller-sa >/dev/null 2>&1; then
    echo "PASS: SA can get namespaces"
else
    echo "FAIL: SA cannot get namespaces"
    exit 1
fi

# Check 7: NetworkPolicy allows kube-system
echo "Check 7: NetworkPolicy for audit ingress"
if kubectl get networkpolicy -n $NAMESPACE cost-controller-audit-ingress >/dev/null 2>&1; then
    echo "PASS: NetworkPolicy exists"
else
    echo "WARN: NetworkPolicy not found (may be optional)"
fi

# Check 8: Metrics exposed
echo "Check 8: Audit metrics exposed"
METRICS=$(kubectl exec -n $NAMESPACE $POD -- wget -qO- --timeout=5 http://localhost:8080/metrics 2>/dev/null)
if echo "$METRICS" | grep -q "finops_audit_events_received_total"; then
    echo "PASS: Audit metrics exposed"
else
    echo "FAIL: Audit metrics not found"
    exit 1
fi

echo ""
echo "=== All Audit Webhook Validations Passed ==="
exit 0
